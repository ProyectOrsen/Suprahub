local part = entry.part
if part and part:IsA("BasePart") and part.Parent then
local partPos = part.Position
local distance = (playerHead.Position - partPos).Magnitude
if distance <= AuraS.reach then
local hitPos = getAuraHitPosition(partPos, playerHead.Position, distance)
if swingEv then pcall(function() swingEv:InvokeServer() end) end
