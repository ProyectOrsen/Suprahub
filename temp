return false
end
AuraS.active = true
notifSet("aura", "Aura ON", true)
AuraS.loopConn = RunService.Heartbeat:Connect(function()
if not AuraS.active then
if AuraS.loopConn then AuraS.loopConn:Disconnect(); AuraS.loopConn = nil end
