local function getHint(text)
local t = text:lower():gsub("^%s+","")
if t:sub(1, #S.prefix) == S.prefix then t = t:sub(#S.prefix + 1) end
if t == "" then return "" end
for _, e in ipairs(cmdHints) do
local m = t:match(e.p)
if m ~= nil then return e.h(m) end
end
return "Type a command... (press ? for help)"
end
local function execCmd(raw)
local str   = raw:lower():gsub("^%s+",""):gsub("%s+$","")
if str == "" then return end
local parts = str:split(" ")
local cmd, arg1 = parts[1], parts[2]
if cmd == "esp" then
if arg1 then
if arg1 == "all" then
if S.ESPenabled then disableESPAll(); updateBtn("esp", false); notifSet("esp", "ESP OFF", false)
else enableESPAll(); updateBtn("esp", true); notifSet("esp", "ESP ON", true) end
elseif arg1 == "others" then
for _, plr in pairs(Players:GetPlayers()) do
if plr ~= lp and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end
end
elseif arg1 == "friends" then
for _, plr in pairs(Players:GetPlayers()) do
if plr ~= lp and isFriend(plr) and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end
end
elseif arg1 == "bacons" or arg1 == "bacon" then
for _, plr in pairs(Players:GetPlayers()) do
if plr ~= lp and isBacon(plr) and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end
end
else
local t = findPlayer(arg1)
if t then
if soloESPPlayers[t.Name] then clearESPSolo(t) else makeESPSolo(t) end
end
end
else
if S.ESPenabled then disableESPAll(); updateBtn("esp", false); notifSet("esp", "ESP OFF", false)
else enableESPAll(); updateBtn("esp", true); notifSet("esp", "ESP ON", true) end
end
elseif cmd == "toggleesp" then
if arg1 then setToggleESPKey(arg1) else setToggleESPKey(nil) end
elseif cmd == "togglefc" or cmd == "togglefreecam" then
if arg1 then setToggleFCKey(arg1) else setToggleFCKey(nil) end
elseif cmd == "togglefly" then
if arg1 then setToggleFlyKey(arg1) else setToggleFlyKey(nil) end
elseif cmd == "togglewalkfling" then
if arg1 then setToggleWalkflingKey(arg1) else setToggleWalkflingKey(nil) end
elseif cmd == "untogglefly" then setToggleFlyKey(nil)
elseif cmd == "untogglefc" then setToggleFCKey(nil)
elseif cmd == "untoggleesp" then setToggleESPKey(nil)
elseif cmd == "toggleaurakey" then
if arg1 then setToggleAuraKey(arg1) else setToggleAuraKey(nil) end
elseif cmd == "untoggleaura" then setToggleAuraKey(nil)
elseif cmd == "togglesafefly" then
if arg1 then setToggleSafeFlyKey(arg1) else setToggleSafeFlyKey(nil) end
elseif cmd == "untogglesafefly" then setToggleSafeFlyKey(nil)
elseif cmd == "predict" then
if not S.abuseMode then return end
local v = tonumber(arg1)
if v then
PredictS.baseTime = math.clamp(v, 0.05, 2.0)
notifSet("predict", string.format("Predict base: %.2fs", PredictS.baseTime), true)
end
elseif cmd == "predictmulti" or cmd == "predictmult" then
if not S.abuseMode then return end
local v = tonumber(arg1)
if v then
PredictS.userMultiplier = math.clamp(v, 0.1, 3.0)
notifSet("predictmulti", string.format("Predict multi: %.2fx", PredictS.userMultiplier), true)
end
elseif cmd == "predictvel" or cmd == "predictvelocity" then
if not S.abuseMode then return end
PredictS.velocityScale = not PredictS.velocityScale
notifSet("predictvel", PredictS.velocityScale and "PredictVel ON" or "PredictVel OFF", PredictS.velocityScale)
elseif cmd == "predictscale" then
if not S.abuseMode then return end
PredictS.distanceScale = not PredictS.distanceScale
notifSet("predictscale", PredictS.distanceScale and "PredictScale ON" or "PredictScale OFF", PredictS.distanceScale)
elseif cmd == "predictgravity" or cmd == "predictgrav" then
if not S.abuseMode then return end
PredictS.gravityComp = not PredictS.gravityComp
notifSet("predictgravity", PredictS.gravityComp and "PredictGravity ON" or "PredictGravity OFF", PredictS.gravityComp)
elseif cmd == "predictmax" then
if not S.abuseMode then return end
local v = tonumber(arg1)
if v then
PredictS.maxTime = math.clamp(v, 0.1, 3.0)
notifSet("predictmax", string.format("PredictMax: %.2fs", PredictS.maxTime), true)
end
elseif cmd == "predictinfo" then
notifSet("predictinfo", string.format("P:%.2f x%.2f %s%s%s max%.2f",
PredictS.baseTime, PredictS.userMultiplier,
PredictS.velocityScale and "V" or "-",
PredictS.distanceScale and "D" or "-",
PredictS.gravityComp and "G" or "-",
PredictS.maxTime), true)
task.delay(3, function() notifSet("predictinfo", "PredictInfo OFF", false) end)
elseif cmd == "esptransparency" or cmd == "espt" then
local v = tonumber(arg1)
if v then S.espAlpha = math.clamp(v, 0.01, 0.95); applyESPTransparency() end
elseif cmd == "unesp" then
if arg1 then
local t = findPlayer(arg1)
if t then clearESPSolo(t) end
else
